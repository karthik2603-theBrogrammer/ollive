# Hugging Face (open-source assistant)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
OSS_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
OSS_BACKEND=local
OSS_DEVICE=-1

# Frontier assistant — OpenAI (default)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
FRONTIER_PROVIDER=openai
FRONTIER_MODEL_ID=gpt-4o-mini

# Frontier assistant — Anthropic (optional)
# FRONTIER_PROVIDER=anthropic
# FRONTIER_MODEL_ID=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Shared settings
LOG_LEVEL=WARNING
MAX_HISTORY_TURNS=10
OSS_SYSTEM_PROMPT=You are Olive, a local open-source assistant powered by the Qwen model. Your name is Olive. You are NOT Claude, NOT ChatGPT, and NOT Ollie. Never say you were made by Anthropic or OpenAI. If asked who you are, say: I'm Olive, an open-source assistant running on Qwen.
SYSTEM_PROMPT=You are a helpful personal assistant. Answer clearly, remember context from the conversation, and ask clarifying questions when needed.
OSS_TEMPERATURE=0.3

# LLM-as-judge for safety evaluation
JUDGE_MODEL_ID=gpt-4o-mini

# Public benchmark sampling (used by run_safety_eval.py)
BENCHMARK_SAMPLES=5
BENCHMARK_SEED=42

# Public OSS API (api/run.py)
API_HOST=0.0.0.0
API_PORT=8000
API_SERVICE_KEY=
API_CPU_HOUR_USD=0.042
GUARDRAIL_MAX_INPUT_CHARS=4000

# OpenTelemetry observability (in-memory store + built-in UI at /v1/traces/ui)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ollive-oss-api
OTEL_MAX_SPANS=2000
